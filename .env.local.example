# -----------------------------------------------------------------------------
# Rococo Creative website: environment variables
# Copy to .env.local for local development. On Vercel, add the same keys under
# Project Settings > Environment Variables (Production and Preview).
# Every variable is optional: without Supabase the site uses local fallback
# content from src/content/fallback.ts.
# -----------------------------------------------------------------------------

# Supabase (Project Settings > API). The anon/publishable key is safe in the
# browser; Row Level Security limits it to published content and form inserts.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Canonical site origin for metadata, sitemap, and Open Graph URLs.
# Leave unset on Vercel to use the production domain automatically.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shared secret for the Supabase Database Webhook that calls /api/revalidate.
# Generate with: openssl rand -hex 32
REVALIDATE_SECRET=

# Optional: email notification for new contact form submissions (Resend).
# Submissions are always stored in Supabase; email is an extra alert.
RESEND_API_KEY=
CONTACT_NOTIFICATION_TO=hello@rocococreative.io
# Must be an address on a domain verified in Resend.
CONTACT_NOTIFICATION_FROM="Rococo Website <website@rocococreative.io>"

# Optional: stylesheet URL that declares the licensed Goldenbook + Halcom
# @font-face rules (see README > Brand fonts). Leave unset to use the
# Cormorant Garamond + Instrument Sans fallbacks.
NEXT_PUBLIC_BRAND_FONTS_URL=
